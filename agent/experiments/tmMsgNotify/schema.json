[
  {
    "namespace": "tmMsgNotify",
    "description": "TabMail experiment API for nsIMsgFolderNotificationService message delta events. Provides real-time notifications for message add/delete/move/copy operations.",
    "events": [
      {
        "name": "onMessageAdded",
        "type": "function",
        "description": "Fired when a message is added to a folder (new mail, move, copy, filter).",
        "parameters": [
          {
            "name": "messageInfo",
            "type": "object",
            "properties": {
              "headerMessageId": { "type": "string", "description": "Message-ID header value" },
              "weMsgId": { "type": "integer", "description": "WebExtension message ID (may be null)" },
              "weFolderId": { "type": "string", "description": "WebExtension folder ID" },
              "folderPath": { "type": "string", "description": "Folder path (e.g., /INBOX, /[Gmail]/Starred)" },
              "accountId": { "type": "string", "description": "Account ID" },
              "subject": { "type": "string" },
              "author": { "type": "string" },
              "dateMs": { "type": "integer", "description": "Message date in epoch milliseconds" },
              "msgKey": { "type": "integer", "description": "msgDB key (IMAP UID for IMAP folders); null if unavailable", "optional": true },
              "eventType": { "type": "string", "description": "Type of add event: added, classified, copyCompleted, moveCompleted, cursorScan" }
            }
          }
        ]
      },
      {
        "name": "onMessageRemoved",
        "type": "function",
        "description": "Fired when a message is removed from a folder (delete, move out, expunge).",
        "parameters": [
          {
            "name": "messageInfo",
            "type": "object",
            "properties": {
              "headerMessageId": { "type": "string", "description": "Message-ID header value" },
              "weFolderId": { "type": "string", "description": "WebExtension folder ID where message was removed from" },
              "folderPath": { "type": "string", "description": "Folder path where message was removed from" },
              "accountId": { "type": "string", "description": "Account ID" },
              "msgKey": { "type": "integer", "description": "msgDB key (IMAP UID for IMAP folders); null if unavailable", "optional": true },
              "eventType": { "type": "string", "description": "Type of remove event: deleted, moveCompleted" }
            }
          }
        ]
      }
    ],
    "functions": [
      {
        "name": "isListenerActive",
        "type": "function",
        "description": "Check if the notification listener is currently active.",
        "async": true,
        "parameters": [],
        "returns": { "type": "boolean" }
      },
      {
        "name": "getCursorFolder",
        "type": "function",
        "description": "Read one IMAP folder's msgDB cursor state for the add-side reconcile cursor (ADR-020). One-folder calls let the WebExtension yield between summary DB opens.",
        "async": true,
        "parameters": [
          { "name": "accountId", "type": "string" },
          { "name": "folderPath", "type": "string" }
        ],
        "returns": {
          "type": "object",
          "properties": {
            "accountId": { "type": "string" },
            "folderPath": { "type": "string" },
            "folderURI": { "type": "string", "description": "Native folder URI for follow-up calls" },
            "uidValidity": { "type": "integer", "optional": true },
            "highWater": { "type": "integer", "description": "Highest msgKey in the local msgDB", "optional": true },
            "totalMessages": { "type": "integer", "optional": true },
            "lookupMs": { "type": "integer", "optional": true },
            "dbOpenMs": { "type": "integer", "optional": true },
            "elapsedMs": { "type": "integer", "optional": true },
            "error": { "type": "string", "optional": true }
          }
        }
      },
      {
        "name": "beginFolderMessageScan",
        "type": "function",
        "description": "Begin an opaque live msgDB header scan whose pages are bounded by readFolderMessageScanPage.",
        "async": true,
        "parameters": [
          { "name": "folderURI", "type": "string" },
          { "name": "includeMessageIds", "type": "boolean" }
        ],
        "returns": {
          "type": "object",
          "properties": {
            "token": { "type": "string", "optional": true },
            "accountId": { "type": "string", "optional": true },
            "folderPath": { "type": "string", "optional": true },
            "serverType": { "type": "string", "optional": true },
            "stableUidKeys": { "type": "boolean", "optional": true },
            "uidValidity": { "type": "integer", "optional": true },
            "highestModSeq": { "type": "string", "optional": true },
            "error": { "type": "string", "optional": true }
          }
        }
      },
      {
        "name": "readFolderMessageScanPage",
        "type": "function",
        "description": "Read at most maxItems rows from an opaque folder scan, yielding control between calls.",
        "async": true,
        "parameters": [
          { "name": "token", "type": "string" },
          { "name": "maxItems", "type": "integer" }
        ],
        "returns": {
          "type": "object",
          "properties": {
            "rows": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "msgKey": { "type": "integer" },
                  "headerMessageId": { "type": "string", "optional": true }
                }
              }
            },
            "done": { "type": "boolean" },
            "error": { "type": "string", "optional": true }
          }
        }
      },
      {
        "name": "cancelFolderMessageScan",
        "type": "function",
        "description": "Cancel and release an opaque folder scan token.",
        "async": true,
        "parameters": [
          { "name": "token", "type": "string" }
        ],
        "returns": {
          "type": "object",
          "properties": {
            "cancelled": { "type": "boolean" }
          }
        }
      },
      {
        "name": "getFolderMessageScanStats",
        "type": "function",
        "description": "Return aggregate-only bounds and current usage for opaque folder scan tokens.",
        "async": true,
        "parameters": [],
        "returns": {
          "type": "object",
          "properties": {
            "live": { "type": "integer" },
            "maxLive": { "type": "integer" },
            "idleTtlMs": { "type": "integer" }
          }
        }
      },
      {
        "name": "getMessageInfosForKeys",
        "type": "function",
        "description": "Resolve msgKeys to serialized messageInfos (same shape as onMessageAdded). Keys whose header no longer exists are omitted.",
        "async": true,
        "parameters": [
          { "name": "folderURI", "type": "string" },
          { "name": "keys", "type": "array", "items": { "type": "integer" } }
        ],
        "returns": {
          "type": "object",
          "properties": {
            "infos": { "type": "array", "items": { "type": "object" } },
            "error": { "type": "string", "optional": true }
          }
        }
      },
      {
        "name": "getFolderState",
        "type": "function",
        "description": "Read one folder's startup identity and UIDVALIDITY state. Other server types report stableUidKeys=false. One-folder calls let the WebExtension yield between summary DB opens.",
        "async": true,
        "parameters": [
          { "name": "accountId", "type": "string" },
          { "name": "folderPath", "type": "string" }
        ],
        "returns": {
          "type": "object",
          "properties": {
            "accountId": { "type": "string" },
            "folderPath": { "type": "string" },
            "folderURI": { "type": "string" },
            "serverType": { "type": "string", "optional": true },
            "stableUidKeys": { "type": "boolean" },
            "uidValidity": { "type": "integer", "optional": true },
            "highestModSeq": { "type": "string", "optional": true },
            "error": { "type": "string", "optional": true }
          }
        }
      },
      {
        "name": "probeMessageIds",
        "type": "function",
        "description": "Probe headerMessageIds (no angle brackets) against a folder's msgDB hash index (getMsgHdrForMessageID). Returns the ids with no header — stale FTS candidates the addon must confirm via verify-then-remove (ADR-017).",
        "async": true,
        "parameters": [
          { "name": "folderURI", "type": "string" },
          { "name": "headerMessageIds", "type": "array", "items": { "type": "string" } }
        ],
        "returns": {
          "type": "object",
          "properties": {
            "missing": { "type": "array", "items": { "type": "string" } },
            "error": { "type": "string", "optional": true }
          }
        }
      }
    ]
  }
]
