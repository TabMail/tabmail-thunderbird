[
  {
    "namespace": "tmComposeRecipients",
    "description": "Atomic recipient proposal commit for accepted inline edits.",
    "types": [
      {
        "id": "Recipients",
        "type": "object",
        "properties": {
          "to": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "cc": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "bcc": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      },
      {
        "id": "Mailbox",
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "email": {
            "type": "string"
          }
        }
      },
      {
        "id": "Delta",
        "type": "object",
        "description": "Mailboxes to add, and addresses to remove (\"*\" removes every recipient of the field).",
        "properties": {
          "adds": {
            "type": "array",
            "items": {
              "$ref": "Mailbox"
            }
          },
          "removes": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      },
      {
        "id": "Deltas",
        "type": "object",
        "properties": {
          "to": {
            "$ref": "Delta",
            "optional": true
          },
          "cc": {
            "$ref": "Delta",
            "optional": true
          },
          "bcc": {
            "$ref": "Delta",
            "optional": true
          }
        }
      }
    ],
    "functions": [
      {
        "name": "begin",
        "type": "function",
        "async": true,
        "parameters": [
          {
            "name": "tabId",
            "type": "integer"
          }
        ],
        "returns": {
          "type": "string"
        }
      },
      {
        "name": "commit",
        "type": "function",
        "async": true,
        "parameters": [
          {
            "name": "tabId",
            "type": "integer"
          },
          {
            "name": "id",
            "type": "string"
          },
          {
            "name": "baseline",
            "$ref": "Recipients"
          },
          {
            "name": "deltas",
            "$ref": "Deltas"
          }
        ],
        "returns": {
          "type": "boolean"
        }
      }
    ]
  }
]
